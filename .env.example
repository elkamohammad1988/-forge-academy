# =============================================================
# Forge Academy — environment configuration
# Copy to `.env` and fill the values for your environment.
# =============================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://forgemartialarts.co.uk
ALLOWED_ORIGINS=https://forgemartialarts.co.uk,http://localhost:3000

# --- Database ---
DB_PATH=./data/forge.db

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-48-byte-random-secret
SESSION_TTL_HOURS=720

# Admin login (used by /admin)
ADMIN_EMAIL=admin@forgemartialarts.co.uk
# Bcrypt hash. Generate: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" -- 'your-strong-password'
ADMIN_PASSWORD_HASH=

# --- Email (nodemailer) ---
# Leave SMTP_HOST blank in dev to use the stream transport (logs emails to stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Forge Manchester <hello@forgemartialarts.co.uk>"
EMAIL_TO_OWNER=hello@forgemartialarts.co.uk

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Map plan slugs to Stripe Price IDs (create them in the Stripe dashboard)
STRIPE_PRICE_KIDS_MONTHLY=price_replace_me
STRIPE_PRICE_KIDS_ANNUAL=price_replace_me
STRIPE_PRICE_UNLIMITED_MONTHLY=price_replace_me
STRIPE_PRICE_UNLIMITED_ANNUAL=price_replace_me
STRIPE_PRICE_FAMILY_MONTHLY=price_replace_me
STRIPE_PRICE_FAMILY_ANNUAL=price_replace_me

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
# Tighter cap for /api/auth/* (login, register, reset) per 15 minutes.
# Leave at the default in production; the test suite raises it internally.
AUTH_RATE_LIMIT_MAX=20

# --- Owner pings on new leads (all optional; leave blank to disable) ---
# Slack: https://api.slack.com/messaging/webhooks
NOTIFY_SLACK_WEBHOOK=
# Discord: server settings → Integrations → Webhooks
NOTIFY_DISCORD_WEBHOOK=
# Telegram bot: @BotFather → /newbot, then add the bot to a group/chat
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Generic JSON webhook (Zapier, Make, n8n, your own CRM):
NOTIFY_GENERIC_WEBHOOK=

# --- Backups ---
BACKUP_KEEP=14

# --- Web push (class reminders, fires 60 min before a booking) ---
# Generate once with: node scripts/vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@forgemartialarts.co.uk

# --- Referral program ---
REFERRAL_CREDIT_MONTHS=1
REFERRAL_REQUIRES_PAID=true

# --- Day pass ---
DAY_PASS_PRICE_PENCE=1800

# --- Coach payroll (rates per class, in £) ---
# JSON map. "*" or "default" is the fallback rate.
# COACH_RATES={"sasha@example.com":40,"lara@example.com":35,"*":30}
COACH_RATES={"*":30}

# --- File uploads ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=5242880
