{
  "name": "forge-academy",
  "version": "1.0.0",
  "description": "Forge Martial Arts Academy — production website with API, member portal, admin & Stripe checkout.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.js\" \"js/**/*.js\" \"server.js\" \"tests/**/*.js\"",
    "build:js": "esbuild js/app.js js/api.js --minify --bundle=false --outdir=dist/js --target=es2020 --legal-comments=none",
    "build:css": "lightningcss --minify --bundle css/styles.css -o dist/css/styles.css",
    "build": "npm run build:js && npm run build:css && node scripts/blog-build.js && node scripts/build-html.js",
    "blog:build": "node scripts/blog-build.js",
    "brand:apply": "node scripts/brand-apply.js",
    "brand:check": "node scripts/brand-apply.js --dry-run",
    "brand:revert": "node scripts/brand-apply.js --revert",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "go-live": "node scripts/go-live.js",
    "setup": "node scripts/setup.js",
    "seed": "node scripts/seed-demo.js",
    "demo": "WIPE=1 node scripts/seed-demo.js && node server.js",
    "db:init": "node -e \"import('./src/db.js').then(m => m.initDb())\"",
    "db:reset": "rm -f data/forge.db && npm run db:init",
    "admin:create": "node scripts/create-admin.js",
    "format": "prettier --write 'src/**/*.{js,json}' '*.{js,json,md}'"
  },
  "dependencies": {
    "@hapi/iron": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "rotating-file-stream": "^3.2.5",
    "stripe": "^17.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.4",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "lightningcss-cli": "^1.27.0",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
